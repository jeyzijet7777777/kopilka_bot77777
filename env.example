# Скопируйте этот файл как .env (локально) или внесите те же значения
# в переменные окружения на хостинге. Настоящий токен в Git не коммитьте.
BOT_TOKEN=сюда_токен_от_BotFather
TZ_NAME=Europe/Moscow

# --- Где лежат данные ---
# ВАЖНО: на хостинге эти пути ДОЛЖНЫ быть внутри постоянного тома (на Bothost это /app/data, на других хостингах путь монтирования тома).
# Переменные хостинга перебивают значения из Dockerfile: DB_PATH=budget.db (без /app/data) на хостинге
# означает базу внутри контейнера, и при каждой пересборке она пропадёт.
DATA_DIR=/app/data
DB_PATH=/app/data/budget.db
STATE_PATH=/app/data/bot_state.pkl

# Локально, без тома, раскомментируйте три строки (иначе бот будет ругаться на путь вне DATA_DIR):
# DATA_DIR=.
# DB_PATH=budget.db
# STATE_PATH=bot_state.pkl
# ALLOW_EPHEMERAL_DB=1

# Telegram ID администраторов через запятую (для /admin, /backup, /restore, предупреждений и копий).
# Пусто — админ-команд и предупреждений нет. Админ должен хотя бы раз написать боту /start.
ADMIN_IDS=

# --- Защита данных ---
# Поставьте 1 на хостинге, когда в базе уже есть данные: пустая база при запуске будет считаться потерей.
EXPECT_EXISTING_DATA=0
# 1 = не запускаться, если DB_PATH вне DATA_DIR (вместо предупреждения админу).
STRICT_DATA_PATH=0
# 1 = не проверять, что DATA_DIR смонтирован как отдельный том (если проверка ошибается на вашем хостинге).
SKIP_MOUNT_CHECK=0
# Сообщение админу при каждом запуске («бот запущен, база N МБ»).
STARTUP_NOTICE=1

# --- Резервные копии ---
# Раз в неделю бот присылает админам файл базы и хранит последние BACKUP_KEEP копий на томе (папка backups).
BACKUP_ENABLED=1
# День недели: 0=пн ... 6=вс (или mon..sun, пн..вс). Время ЧЧ:ММ в часовом поясе TZ_NAME.
BACKUP_WEEKDAY=6
BACKUP_TIME=03:00
BACKUP_KEEP=8
# BACKUP_DIR=/app/data/backups

# --- Перенос старой базы ---
# Бот сам ищет старые budget.db и bot_state.pkl в рабочей папке и рядом с bot.py и копирует их на том (оригинал не трогает).
# Если у хостинга старая база лежит в другой папке, укажите её здесь:
# LEGACY_DIR=/app

# --- Отчёт за прошлый месяц ---
# 1-го числа после указанного времени (часовой пояс TZ_NAME) бот присылает итоги прошлого месяца.
MONTH_REPORT_ENABLED=1
MONTH_REPORT_TIME=09:00
# Если бот 1-го числа не работал, отчёт догоняется в течение первых N дней месяца.
MONTH_REPORT_WINDOW_DAYS=3

# --- Недельная сводка ---
# По понедельникам после указанного времени (часовой пояс TZ_NAME) бот присылает итоги прошлой недели (пн–вс).
WEEK_SUMMARY_ENABLED=1
WEEK_SUMMARY_TIME=09:00
# Если бот в понедельник не работал, сводка догоняется в течение первых N дней недели (1–6).
WEEK_SUMMARY_WINDOW_DAYS=2

# --- Виджеты iOS/Android и Telegram Web App ---
# WIDGET_API_HOST=0.0.0.0
# WIDGET_API_PORT=8080
# WIDGET_API_BASE_URL=https://your-domain.com
